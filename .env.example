# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
#
# NEVER put secret keys (FAIRSURE_PRIVATE_KEY, database passwords, SUPABASE_SERVICE_ROLE_KEY) in
# NEXT_PUBLIC_* variables: anything starting with NEXT_PUBLIC_ is visible in the browser.

# Enables the demo checkout-init route /api/checkout used by the mock API (no real money moves).
# Remove once the backend's own POST /orders route is live (see BACKEND.md).
MOCK_PAYMENTS=true

# ── Data source ──────────────────────────────────────────────
# mock     -> demo store in the browser (localStorage). Default.
# http     -> the backend's REST API at NEXT_PUBLIC_API_BASE_URL (src/lib/api/http.ts).
#             Primary production path: Next.js API routes in this app, any database.
# supabase -> optional: src/lib/api/supabase.ts (not written; see the appendix in BACKEND.md)
NEXT_PUBLIC_API_MODE=mock

# Legacy switch, still honoured when NEXT_PUBLIC_API_MODE is not set:
# NEXT_PUBLIC_USE_MOCK_API=false  is the same as  NEXT_PUBLIC_API_MODE=http

# REST API base URL, no trailing slash. Only used in "http" mode.
# Next.js API routes in this same app:  /api/v1
# Separate server:                      https://api.rebelfashion.ng/api/v1
NEXT_PUBLIC_API_BASE_URL=

# ── Payments: Fairsure (https://docs.fairsurepay.com/) ──────
# "sandbox" (default) or "live". Picks the Fairsure inline checkout script and checkout host.
NEXT_PUBLIC_FAIRSURE_ENV=sandbox
# PUBLIC key from merchant.fairsurepay.com → Settings → API keys: TEST_… (sandbox) or LIVE_….
# Optional if the backend returns `publicKey` from POST /orders.
# Demo store: leave empty for the instant demo payment; set a TEST_ key to open the real sandbox modal.
NEXT_PUBLIC_FAIRSURE_PUBLIC_KEY=
# SERVER-ONLY private key (test_… / live_…). Used by the backend to verify transactions
# (GET /api/v1/transactions/{ref}) and to check the webhook X-Paysure-Signature. Never NEXT_PUBLIC_.
FAIRSURE_PRIVATE_KEY=
# Server-only base URL for the transaction API: https://sandbox.fairsurepay.com (test) or https://api.fairsurepay.com (live)
FAIRSURE_API_BASE=https://sandbox.fairsurepay.com

# ── Your database (http mode) ───────────────────────────────
# Whatever the backend developer chooses, e.g. DATABASE_URL=postgres://…  (server-only)
DATABASE_URL=

# ── Supabase (only for the optional "supabase" mode) ────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Store info (public, shown in the UI) ────────────────────
# Public site URL: canonical links, Open Graph images, sitemap.xml and robots.txt. No trailing slash.
# Defaults to https://rebel-fashion-2.vercel.app when empty. Set it to your real domain in production.
NEXT_PUBLIC_SITE_URL=
# WhatsApp number in international format, digits only (no +, no spaces), e.g. 2348012345678.
# When set: the floating WhatsApp button, "Ask on WhatsApp" on product pages and the Help page chat link appear.
# When empty they are all hidden. Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Customer support email shown on /help (and used in the terms/privacy contact lines). Leave empty to hide.
NEXT_PUBLIC_SUPPORT_EMAIL=
